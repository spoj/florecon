# starter-plugin — task runner. `just` with no args lists recipes.
#
# Recipe bodies are single commands with forward-slash paths and no shell-
# specific syntax, so they run identically under Linux sh, Git Bash, cmd, and
# PowerShell. On Windows we route to Git Bash (assumed installed).
set windows-shell := ["bash", "-uc"]

default:
    @just --list

# Phase 1 — the author loop. Build + run the strategy ONCE on the sample,
# native and fast (deps at -O3 cached, your crate light, no LTO). Edit
# solver/src/lib.rs, re-run, read the report. This is the inner loop.
author data="data/sample.csv":
    cargo run --profile author -p harness -- {{data}}

# Type-check the plugin without building anything (fastest feedback).
check:
    cargo clippy -p solver

# Phase 2 — ship. Build the production wasm (perf profile: full opt + LTO).
# The artifact is solver/target/wasm32-unknown-unknown/release/solver.wasm.
ship:
    cargo build -p solver --release --target wasm32-unknown-unknown
