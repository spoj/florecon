{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://florecon.dev/schema/plan-1.json",
  "title": "florecon wire contract",
  "description": "The shapes that cross the florecon boundary: a Plan (the strategy tree as data), the interactive Cmd protocol that drives a persistent workspace, and the allocation-native Report. Contract version 18 (see plan::CONTRACT_VERSION / the abi_version wasm export). There is a single `dispatch` entry point and a single Cmd protocol; a stateless batch solve is just `init` + `solve`. Rows and column identity cross out-of-band as an Arrow IPC batch whose schema is the column map; no schema/map rides this JSON.",
  "x-contract-version": 18,
  "$defs": {
    "Cond": {
      "description": "A predicate on a candidate pair used by the flow cost model.",
      "enum": [
        "token_shared",
        "amount_equal"
      ]
    },
    "Tol": {
      "description": "Absolute slack (an integer) or relative: { bps, floor? } against a context scale.",
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "object",
          "properties": {
            "bps": {
              "type": "integer"
            },
            "floor": {
              "type": "integer",
              "default": 0
            }
          },
          "required": [
            "bps"
          ],
          "additionalProperties": false
        }
      ]
    },
    "CostTier": {
      "type": "object",
      "properties": {
        "when": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Cond"
          }
        },
        "base": {
          "type": "number"
        },
        "slope": {
          "type": "number",
          "default": 0
        },
        "amount_tol": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tol"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "when",
        "base"
      ],
      "additionalProperties": false
    },
    "CostSpec": {
      "description": "The flow arbiter's cost as ordered confidence tiers; first satisfied tier wins, no tier means the pair is forbidden. Omitted in a Flow node means the default reference-bridge > exact-amount cascade.",
      "type": "object",
      "properties": {
        "tiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CostTier"
          }
        }
      },
      "required": [
        "tiers"
      ],
      "additionalProperties": false
    },
    "Plan": {
      "description": "A reconciliation plan with one primary report/conservation numeraire and a strategy root.",
      "type": "object",
      "properties": {
        "primary": {
          "$ref": "#/$defs/ScalarRef"
        },
        "root": {
          "$ref": "#/$defs/PlanNode"
        }
      },
      "required": [
        "primary",
        "root"
      ],
      "additionalProperties": false
    },
    "SolveRequest": {
      "description": "Deprecated alias kept for tooling: a batch solve is now the `init` command followed by `solve`. Equivalent to the payload of a `fixed_point`-free `init`.",
      "$ref": "#/$defs/Cmd"
    },
    "Cmd": {
      "description": "An interactive command driving the stateful Workspace via the wasm `dispatch` export. Tagged union on `op`.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "init"
            },
            "plan": {
              "$ref": "#/$defs/Plan"
            }
          },
          "required": [
            "op",
            "plan"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Recompile a new Plan against the live schema and swap it into the existing workspace, preserving rows and frozen decisions. The next `solve` re-matches under it.",
          "properties": {
            "op": {
              "const": "replan"
            },
            "plan": {
              "$ref": "#/$defs/Plan"
            }
          },
          "required": [
            "op",
            "plan"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "upsert"
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "remove"
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "required": [
            "op",
            "ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "solve"
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "freeze"
            },
            "group_id": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "op",
            "group_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "freeze_singletons"
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "required": [
            "op",
            "ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "freeze_clean"
            },
            "tol": {
              "type": "integer"
            }
          },
          "required": [
            "op",
            "tol"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "unfreeze"
            },
            "group_id": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "op",
            "group_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "breakup"
            },
            "group_id": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "op",
            "group_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "group"
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "net": {
              "type": "integer"
            },
            "origin": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "group_allocations"
            },
            "allocations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AllocationSpec"
              }
            },
            "origin": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "allocations"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "remove_allocations"
            },
            "group_id": {
              "type": "integer",
              "minimum": 0
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "required": [
            "op",
            "group_id",
            "ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "ungroup"
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "required": [
            "op",
            "ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "report"
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false
        }
      ]
    },
    "GroupOut": {
      "type": "object",
      "properties": {
        "group_id": {
          "type": "integer",
          "minimum": 0
        },
        "origin": {
          "type": "string"
        },
        "net": {
          "type": "integer"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "live",
            "frozen"
          ],
          "description": "the single recalc axis; present on Workspace (dispatch) reports only"
        }
      },
      "required": [
        "group_id",
        "origin",
        "net",
        "size",
        "status"
      ],
      "additionalProperties": false
    },
    "Report": {
      "description": "The allocation-native reconciliation result. Groups plus allocation incidences are the single source of truth; row-level groupings are explicit client projections.",
      "type": "object",
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GroupOut"
          }
        },
        "allocations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AllocationOut"
          }
        }
      },
      "required": [
        "groups",
        "allocations"
      ],
      "additionalProperties": false
    },
    "AllocationOut": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "group_id": {
          "type": "integer"
        },
        "amount": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "group_id",
        "amount"
      ],
      "additionalProperties": false
    },
    "AllocationSpec": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "amount": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "amount"
      ],
      "additionalProperties": false
    },
    "Envelope": {
      "description": "The response wrapper for both solve and dispatch: ok plus an optional report or error.",
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "report": {
          "anyOf": [
            {
              "$ref": "#/$defs/Report"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ok"
      ],
      "additionalProperties": false
    },
    "ScalarRef": {
      "type": "string"
    },
    "BoolRef": {
      "type": "string"
    },
    "PlanNode": {
      "description": "A reconciliation strategy tree. Tagged union on `op`; primitives operate on the current allocation amount.",
      "oneOf": [
        {
          "title": "seq",
          "type": "object",
          "properties": {
            "op": {
              "const": "seq"
            },
            "steps": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PlanNode"
              }
            }
          },
          "required": [
            "op",
            "steps"
          ],
          "additionalProperties": false
        },
        {
          "title": "fixed_point",
          "description": "Repeat `inner` on its own residual until a pass changes nothing more, or `max` passes elapse. Stateful leaves inside `inner` persist across passes.",
          "type": "object",
          "properties": {
            "op": {
              "const": "fixed_point"
            },
            "inner": {
              "$ref": "#/$defs/PlanNode"
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "default": 16
            }
          },
          "required": [
            "op",
            "inner"
          ],
          "additionalProperties": false
        },
        {
          "title": "partition",
          "type": "object",
          "properties": {
            "op": {
              "const": "partition"
            },
            "by": {
              "$ref": "#/$defs/ScalarRef"
            },
            "inner": {
              "$ref": "#/$defs/PlanNode"
            }
          },
          "required": [
            "op",
            "by",
            "inner"
          ],
          "additionalProperties": false
        },
        {
          "title": "branch",
          "type": "object",
          "properties": {
            "op": {
              "const": "branch"
            },
            "pred": {
              "$ref": "#/$defs/BoolRef"
            },
            "and_then": {
              "$ref": "#/$defs/PlanNode"
            },
            "or_else": {
              "$ref": "#/$defs/PlanNode"
            }
          },
          "required": [
            "op",
            "pred",
            "and_then",
            "or_else"
          ],
          "additionalProperties": false
        },
        {
          "title": "windowed",
          "type": "object",
          "properties": {
            "op": {
              "const": "windowed"
            },
            "order": {
              "$ref": "#/$defs/ScalarRef"
            },
            "width": {
              "type": "integer"
            },
            "inner": {
              "$ref": "#/$defs/PlanNode"
            }
          },
          "required": [
            "op",
            "order",
            "width",
            "inner"
          ],
          "additionalProperties": false
        },
        {
          "title": "pivot",
          "type": "object",
          "properties": {
            "op": {
              "const": "pivot"
            },
            "amount": {
              "$ref": "#/$defs/ScalarRef"
            },
            "inner": {
              "$ref": "#/$defs/PlanNode"
            }
          },
          "required": [
            "op",
            "amount",
            "inner"
          ],
          "additionalProperties": false
        },
        {
          "title": "filter",
          "description": "Gate `inner`'s output: keep only groups for which the `keep` selector (a Sel over group metrics, non-zero = keep) holds; dissolve the rest back into the residual. Group-metric lanes: size, pos, neg, min_side, max_side, net, abs_net, max_abs, min_abs.",
          "type": "object",
          "properties": {
            "op": {
              "const": "filter"
            },
            "keep": {
              "$ref": "#/$defs/ScalarRef"
            },
            "inner": {
              "$ref": "#/$defs/PlanNode"
            }
          },
          "required": [
            "op",
            "keep",
            "inner"
          ],
          "additionalProperties": false
        },
        {
          "title": "coalesce",
          "description": "Collapse `inner`'s allocation-hyperedge groups into connected-component clusters: groups sharing any member id merge into one coarse group (each row's allocations summed to one edge), uniformly stamped with `origin`. Pure group->group transform: the residual is never touched. Compose with `trim`/`snap` to move material to/from the residual.",
          "type": "object",
          "properties": {
            "op": {
              "const": "coalesce"
            },
            "origin": {
              "type": "string"
            },
            "inner": {
              "$ref": "#/$defs/PlanNode"
            }
          },
          "required": [
            "op",
            "origin",
            "inner"
          ],
          "additionalProperties": false
        },
        {
          "title": "trim",
          "description": "Cut every group edge within `tol` (of its row's `original`) to the residual — matched -> residual, one-directional. Trimming a bridging edge splits a cluster, so `trim` before `coalesce` yields smaller islands and more residual. Post-condition: every surviving group edge is material.",
          "type": "object",
          "properties": {
            "op": {
              "const": "trim"
            },
            "tol": {
              "$ref": "#/$defs/Tol"
            },
            "inner": {
              "$ref": "#/$defs/PlanNode"
            }
          },
          "required": [
            "op",
            "tol",
            "inner"
          ],
          "additionalProperties": false
        },
        {
          "title": "snap",
          "description": "Fold every sub-`tol` edge onto its row's dominant edge instead of the floor. The residual edge is eligible both ways, so a small tail absorbs into its group while a small match leaks to residual — whichever side is the minority. The dominant edge never folds into itself, so a clean match is never silently un-matched.",
          "type": "object",
          "properties": {
            "op": {
              "const": "snap"
            },
            "tol": {
              "$ref": "#/$defs/Tol"
            },
            "inner": {
              "$ref": "#/$defs/PlanNode"
            }
          },
          "required": [
            "op",
            "tol",
            "inner"
          ],
          "additionalProperties": false
        },
        {
          "title": "soak_small",
          "type": "object",
          "properties": {
            "op": {
              "const": "soak_small"
            },
            "max_bps": {
              "type": [
                "integer",
                "null"
              ]
            },
            "max_abs": {
              "type": [
                "integer",
                "null"
              ]
            },
            "origin": {
              "type": "string"
            },
            "by": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ScalarRef"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "op",
            "origin"
          ],
          "additionalProperties": false
        },
        {
          "title": "soak_all",
          "type": "object",
          "properties": {
            "op": {
              "const": "soak_all"
            },
            "origin": {
              "type": "string"
            },
            "by": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ScalarRef"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "op",
            "origin"
          ],
          "additionalProperties": false
        },
        {
          "title": "agg_net",
          "type": "object",
          "properties": {
            "op": {
              "const": "agg_net"
            },
            "key": {
              "$ref": "#/$defs/ScalarRef"
            },
            "tol": {
              "type": "integer"
            }
          },
          "required": [
            "op",
            "key",
            "tol"
          ],
          "additionalProperties": false
        },
        {
          "title": "exact",
          "type": "object",
          "properties": {
            "op": {
              "const": "exact"
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false
        },
        {
          "title": "signal",
          "type": "object",
          "properties": {
            "op": {
              "const": "signal"
            },
            "signals": {
              "type": "string"
            },
            "tol": {
              "type": "integer"
            },
            "cap": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "op",
            "signals",
            "tol",
            "cap"
          ],
          "additionalProperties": false
        },
        {
          "title": "flow",
          "type": "object",
          "properties": {
            "op": {
              "const": "flow"
            },
            "order_by": {
              "$ref": "#/$defs/ScalarRef"
            },
            "tokens": {
              "type": "string"
            },
            "penalty": {
              "type": "number"
            },
            "window": {
              "type": "integer"
            },
            "cost": {
              "$ref": "#/$defs/CostSpec"
            }
          },
          "required": [
            "op",
            "order_by",
            "tokens",
            "penalty",
            "window"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$ref": "#/$defs/Cmd"
}