{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://florecon.dev/schema/plan-1.json",
  "title": "florecon wire contract",
  "description": "The shapes that cross the florecon boundary: a Plan (the strategy tree as data), the interactive Cmd set, and the allocation-native Report. Contract version 7 (see plan::CONTRACT_VERSION / the abi_version wasm export).",
  "x-contract-version": 7,
  "$defs": {
    "Cell": {
      "description": "A bare input cell: a number or a string. How it lowers is decided by its column's Kind in the Schema, not by the cell, so there is no per-cell tag. A Number column takes the integer as-is; a Key column lowers a string via FNV-1a (a numeric cell is an already-lowered key); a Tokens column lowers a free-text string to a reference-token set. The lowered engine form is internal and never on the wire. See src/lower.rs.",
      "type": [
        "integer",
        "string"
      ]
    },
    "Kind": {
      "description": "How a column's cells lower.",
      "enum": [
        "number",
        "key",
        "tokens"
      ]
    },
    "Column": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "additionalProperties": false
    },
    "Schema": {
      "type": "object",
      "properties": {
        "cols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Column"
          }
        },
        "token_drop": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "stopwords for Tokens lowering, matched upper-cased; optional"
        }
      },
      "required": [
        "cols"
      ],
      "additionalProperties": false
    },
    "Row": {
      "description": "A bare positional row: one Cell per schema column.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Cell"
      }
    },
    "IdRow": {
      "description": "A (ExtId, Row) pair: a caller-owned u64 id and its positional row.",
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "$ref": "#/$defs/Row"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "Cond": {
      "description": "A predicate on a candidate pair used by the flow cost model.",
      "enum": [
        "token_shared",
        "amount_equal"
      ]
    },
    "CostTier": {
      "type": "object",
      "properties": {
        "when": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Cond"
          }
        },
        "base": {
          "type": "number"
        },
        "day_slope": {
          "type": "number",
          "default": 0
        },
        "max_day": {
          "type": [
            "integer",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "when",
        "base"
      ],
      "additionalProperties": false
    },
    "CostSpec": {
      "description": "The flow arbiter's cost as ordered confidence tiers; first satisfied tier wins, no tier means the pair is forbidden. Omitted in a Flow node means the default reference-bridge > exact-amount cascade.",
      "type": "object",
      "properties": {
        "tiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CostTier"
          }
        }
      },
      "required": [
        "tiers"
      ],
      "additionalProperties": false
    },
    "Plan": {
      "description": "A reconciliation pipeline as data. Tagged union on `op`; every leaf references columns by name.",
      "oneOf": [
        {
          "title": "seq",
          "type": "object",
          "properties": {
            "op": {
              "const": "seq"
            },
            "steps": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Plan"
              }
            }
          },
          "required": [
            "op",
            "steps"
          ],
          "additionalProperties": false
        },
        {
          "title": "partition",
          "type": "object",
          "properties": {
            "op": {
              "const": "partition"
            },
            "by": {
              "$ref": "#/$defs/ScalarRef"
            },
            "inner": {
              "$ref": "#/$defs/Plan"
            }
          },
          "required": [
            "op",
            "by",
            "inner"
          ],
          "additionalProperties": false
        },
        {
          "title": "branch",
          "type": "object",
          "properties": {
            "op": {
              "const": "branch"
            },
            "pred": {
              "$ref": "#/$defs/BoolRef"
            },
            "and_then": {
              "$ref": "#/$defs/Plan"
            },
            "or_else": {
              "$ref": "#/$defs/Plan"
            }
          },
          "required": [
            "op",
            "pred",
            "and_then",
            "or_else"
          ],
          "additionalProperties": false
        },
        {
          "title": "windowed",
          "type": "object",
          "properties": {
            "op": {
              "const": "windowed"
            },
            "order": {
              "$ref": "#/$defs/ScalarRef"
            },
            "width": {
              "type": "integer"
            },
            "inner": {
              "$ref": "#/$defs/Plan"
            }
          },
          "required": [
            "op",
            "order",
            "width",
            "inner"
          ],
          "additionalProperties": false
        },
        {
          "title": "lots",
          "type": "object",
          "properties": {
            "op": {
              "const": "lots"
            },
            "amount": {
              "$ref": "#/$defs/ScalarRef"
            },
            "inner": {
              "$ref": "#/$defs/Plan"
            }
          },
          "required": [
            "op",
            "amount",
            "inner"
          ],
          "additionalProperties": false
        },
        {
          "title": "soak_small",
          "type": "object",
          "properties": {
            "op": {
              "const": "soak_small"
            },
            "max_bps": {
              "type": ["integer", "null"]
            },
            "max_abs": {
              "type": ["integer", "null"]
            },
            "origin": {
              "type": "string"
            },
            "by": {
              "anyOf": [
                { "$ref": "#/$defs/ScalarRef" },
                { "type": "null" }
              ]
            }
          },
          "required": [
            "op",
            "origin"
          ],
          "additionalProperties": false
        },
        {
          "title": "soak_all",
          "type": "object",
          "properties": {
            "op": {
              "const": "soak_all"
            },
            "origin": {
              "type": "string"
            },
            "by": {
              "anyOf": [
                { "$ref": "#/$defs/ScalarRef" },
                { "type": "null" }
              ]
            }
          },
          "required": [
            "op",
            "origin"
          ],
          "additionalProperties": false
        },
        {
          "title": "agg_net",
          "type": "object",
          "properties": {
            "op": {
              "const": "agg_net"
            },
            "key": {
              "$ref": "#/$defs/ScalarRef"
            },
            "amount": {
              "$ref": "#/$defs/ScalarRef"
            },
            "tol": {
              "type": "integer"
            }
          },
          "required": [
            "op",
            "key",
            "amount",
            "tol"
          ],
          "additionalProperties": false
        },
        {
          "title": "exact",
          "type": "object",
          "properties": {
            "op": {
              "const": "exact"
            },
            "amount": {
              "$ref": "#/$defs/ScalarRef"
            }
          },
          "required": [
            "op",
            "amount"
          ],
          "additionalProperties": false
        },
        {
          "title": "signal",
          "type": "object",
          "properties": {
            "op": {
              "const": "signal"
            },
            "signals": {
              "type": "string"
            },
            "amount": {
              "$ref": "#/$defs/ScalarRef"
            },
            "tol": {
              "type": "integer"
            },
            "cap": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "op",
            "signals",
            "amount",
            "tol",
            "cap"
          ],
          "additionalProperties": false
        },
        {
          "title": "flow",
          "type": "object",
          "properties": {
            "op": {
              "const": "flow"
            },
            "amount": {
              "$ref": "#/$defs/ScalarRef"
            },
            "day": {
              "$ref": "#/$defs/ScalarRef"
            },
            "tokens": {
              "type": "string"
            },
            "penalty": {
              "type": "number"
            },
            "window": {
              "type": "integer"
            },
            "cost": {
              "$ref": "#/$defs/CostSpec"
            }
          },
          "required": [
            "op",
            "amount",
            "day",
            "tokens",
            "penalty",
            "window"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SolveRequest": {
      "description": "A self-contained batch solve: the JSON passed to the wasm `solve` export.",
      "type": "object",
      "properties": {
        "schema": {
          "$ref": "#/$defs/Schema"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IdRow"
          }
        },
        "plan": {
          "$ref": "#/$defs/Plan"
        }
      },
      "required": [
        "schema",
        "rows",
        "plan"
      ],
      "additionalProperties": false
    },
    "Cmd": {
      "description": "An interactive command driving the stateful Workspace via the wasm `dispatch` export. Tagged union on `op`.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "init"
            },
            "schema": {
              "$ref": "#/$defs/Schema"
            },
            "plan": {
              "$ref": "#/$defs/Plan"
            },
            "rows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/IdRow"
              }
            }
          },
          "required": [
            "op",
            "schema",
            "plan",
            "rows"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "upsert"
            },
            "rows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/IdRow"
              }
            }
          },
          "required": [
            "op",
            "rows"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "remove"
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "required": [
            "op",
            "ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "solve"
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "freeze"
            },
            "group_id": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "op",
            "group_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "freeze_singletons"
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "required": [
            "op",
            "ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "freeze_clean"
            },
            "tol": {
              "type": "integer"
            }
          },
          "required": [
            "op",
            "tol"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "unfreeze"
            },
            "group_id": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "op",
            "group_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "breakup"
            },
            "group_id": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "op",
            "group_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "group"
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "net": {
              "type": "integer"
            },
            "origin": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "group_allocations"
            },
            "allocations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AllocationSpec"
              }
            },
            "origin": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "allocations"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "remove_allocations"
            },
            "group_id": {
              "type": "integer",
              "minimum": 0
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "required": [
            "op",
            "group_id",
            "ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "ungroup"
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "required": [
            "op",
            "ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "report"
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false
        }
      ]
    },
    "GroupOut": {
      "type": "object",
      "properties": {
        "group_id": {
          "type": "integer",
          "minimum": 0
        },
        "origin": {
          "type": "string"
        },
        "net": {
          "type": "integer"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "live",
            "frozen"
          ],
          "description": "the single recalc axis; present on Workspace (dispatch) reports only"
        }
      },
      "required": [
        "group_id",
        "origin",
        "net",
        "size",
        "status"
      ],
      "additionalProperties": false
    },
    "Report": {
      "description": "The allocation-native reconciliation result. Groups plus allocation incidences are the single source of truth; row-level groupings are explicit client projections.",
      "type": "object",
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GroupOut"
          }
        },
        "allocations": {
          "type": "array",
          "items": { "$ref": "#/$defs/AllocationOut" }
        }
      },
      "required": [
        "groups",
        "allocations"
      ],
      "additionalProperties": false
    },
    "AllocationOut": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "group_id": { "type": "integer" },
        "amount": { "type": "integer" }
      },
      "required": ["id", "group_id", "amount"],
      "additionalProperties": false
    },
    "AllocationSpec": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "amount": { "type": "integer" }
      },
      "required": ["id", "amount"],
      "additionalProperties": false
    },
    "Envelope": {
      "description": "The response wrapper for both solve and dispatch: ok plus an optional report or error.",
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "report": {
          "anyOf": [
            {
              "$ref": "#/$defs/Report"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ok"
      ],
      "additionalProperties": false
    },
    "ScalarExpr": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "col": {
              "type": "string"
            }
          },
          "required": [
            "col"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "lit": {
              "type": "integer"
            }
          },
          "required": [
            "lit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "abs": {
              "$ref": "#/$defs/ScalarRef"
            }
          },
          "required": [
            "abs"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "neg": {
              "$ref": "#/$defs/ScalarRef"
            }
          },
          "required": [
            "neg"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "add": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ScalarRef"
              }
            }
          },
          "required": [
            "add"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "sub": {
              "type": "array",
              "prefixItems": [
                {
                  "$ref": "#/$defs/ScalarRef"
                },
                {
                  "$ref": "#/$defs/ScalarRef"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "sub"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ScalarRef": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/ScalarExpr"
        }
      ]
    },
    "BoolExpr": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "bool": {
              "type": "boolean"
            }
          },
          "required": [
            "bool"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/BoolRef"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "and": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/BoolRef"
              }
            }
          },
          "required": [
            "and"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "or": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/BoolRef"
              }
            }
          },
          "required": [
            "or"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "eq": {
              "type": "array",
              "prefixItems": [
                {
                  "$ref": "#/$defs/ScalarRef"
                },
                {
                  "$ref": "#/$defs/ScalarRef"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "eq"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ne": {
              "type": "array",
              "prefixItems": [
                {
                  "$ref": "#/$defs/ScalarRef"
                },
                {
                  "$ref": "#/$defs/ScalarRef"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "ne"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "gt": {
              "type": "array",
              "prefixItems": [
                {
                  "$ref": "#/$defs/ScalarRef"
                },
                {
                  "$ref": "#/$defs/ScalarRef"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "gt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ge": {
              "type": "array",
              "prefixItems": [
                {
                  "$ref": "#/$defs/ScalarRef"
                },
                {
                  "$ref": "#/$defs/ScalarRef"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "ge"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "lt": {
              "type": "array",
              "prefixItems": [
                {
                  "$ref": "#/$defs/ScalarRef"
                },
                {
                  "$ref": "#/$defs/ScalarRef"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "lt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "le": {
              "type": "array",
              "prefixItems": [
                {
                  "$ref": "#/$defs/ScalarRef"
                },
                {
                  "$ref": "#/$defs/ScalarRef"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "le"
          ],
          "additionalProperties": false
        }
      ]
    },
    "BoolRef": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/BoolExpr"
        }
      ]
    }
  },
  "$ref": "#/$defs/SolveRequest"
}